# Copy to .env and fill in. NEVER commit .env.
# Plain settings (read by clearsky.config.Settings). Every key in IMPLEMENTATION.md §13 can be set here.
STAGE=dev
AWS_REGION=ap-south-1
TABLE_PREFIX=clearsky-dev-
# Bedrock model or inference-profile ID with tool use, chosen by the team (no default on purpose)
BEDROCK_MODEL_ID=
# Set after deploy, from the stack outputs
DATA_BUCKET=
MEDIA_BUCKET=
# Local DynamoDB (e.g. http://localhost:8000). Leave empty for real AWS.
DDB_ENDPOINT_URL=
DEMO_MODE=true

# Secrets: scripts/put_secrets.sh copies these into SSM SecureStrings under /clearsky/{STAGE}/...
# Lambdas read them from SSM; locally they're read from here.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
FIRMS_MAP_KEY=

# Pollution avoided (issue #5). Leave empty until the team has chosen PUBLISHED emission factors for
# open burning of rice straw. Each factor needs its citation; a factor without "source" is ignored.
# Pollutants: pm25, pm10, co, co2, bc. Unit: kg per tonne of straw burnt. One line of JSON:
#   EMISSION_FACTORS={"pm25":{"kg_per_tonne":<value>,"source":"<author, year, journal>","url":"<doi link>"}}
EMISSION_FACTORS=
# Share of unbooked straw assumed burnt (1.0 = "if burnt"). A value below 1 needs its own citation.
BURN_FRACTION=1.0

# Offers (issue #3): minutes a baler has to answer, balers asked before escalating to the officer,
# and AUTO_ACCEPT_DEMO=true to confirm bookings instantly (no baler step).
OFFER_SLA_MINUTES=120
OFFER_MAX_ATTEMPTS=3
AUTO_ACCEPT_DEMO=false
